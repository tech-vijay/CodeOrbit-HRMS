datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum OrganizationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  PENDING_VERIFICATION
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REVOKED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_RESET
  TOKEN_REFRESH
  TOKEN_REUSE_DETECTED
  ORGANIZATION_SWITCH
  PERMISSION_GRANT
  PERMISSION_REVOKE
  EXPORT
}

enum EmployeeStatus {
  PROBATION
  ACTIVE
  NOTICE_PERIOD
  TERMINATED
  RESIGNED
  ON_LEAVE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  REMOTE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  ON_LEAVE
  HOLIDAY
  WEEK_OFF
}

enum BreakType {
  LUNCH
  TEA
  PERSONAL
  MEETING
}

enum RegularizationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  APPROVED
  PAID
  CANCELLED
}

enum DocumentType {
  IDENTITY_PROOF
  EMPLOYMENT_CONTRACT
  OFFER_LETTER
  RESUME
  EDUCATIONAL_CERTIFICATE
  EXPERIENCE_LETTER
  PAYSLIP_PREVIOUS
  OTHER
}

enum OnboardingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  WAIVED
}

enum OnboardingTaskCategory {
  DOCUMENT_SUBMISSION
  IT_PROVISIONING
  HR_ORIENTATION
  POLICY_ACKNOWLEDGEMENT
  TRAINING
}

enum LifecycleEventType {
  HIRED
  PROBATION_COMPLETED
  PROMOTED
  DESIGNATION_CHANGE
  DEPARTMENT_TRANSFER
  SALARY_REVISION
  RESIGNED
  TERMINATED
}

// -------------------------------------------------------------
// CORE MULTI-TENANCY & RBAC MODELS
// -------------------------------------------------------------

model Organization {
  id           String             @id @default(uuid())
  name         String
  slug         String             @unique
  legalName    String?
  logoUrl      String?
  website      String?
  email        String
  phone        String?
  taxId        String?
  status       OrganizationStatus @default(ACTIVE)
  
  // Regional & operational settings
  timezone     String             @default("Asia/Kolkata")
  currency     String             @default("INR")
  address      String?
  city         String?
  state        String?
  country      String             @default("India")
  postalCode   String?
  
  // Organization Employee & Working Policy Settings
  employeeCodePrefix   String       @default("EMP")
  employeeCodeCounter  Int          @default(1)
  workingDays          String[]     @default(["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY"])
  
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  // Relationships
  memberships        Membership[]
  roles              Role[]
  departments        Department[]
  designations       Designation[]
  branches           Branch[]
  employees          Employee[]
  employeeDocuments  EmployeeDocument[]
  onboardingTasks    OnboardingTask[]
  lifecycleEvents    LifecycleEvent[]
  auditLogs          AuditLog[]
  refreshSessions    RefreshSession[]
  shifts             Shift[]
  attendances        Attendance[]
  attendanceRegularizations AttendanceRegularization[]
  leaveTypes         LeaveType[]
  leaveRequests      LeaveRequest[]
  payrollRuns        PayrollRun[]

  @@index([slug])
  @@index([status])
  @@map("organizations")
}

model User {
  id                  String       @id @default(uuid())
  email               String       @unique
  passwordHash        String
  firstName           String
  lastName            String
  phone               String?
  avatarUrl           String?
  isSuperAdmin        Boolean      @default(false)
  isEmailVerified     Boolean      @default(false)
  status              UserStatus   @default(ACTIVE)
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // Relationships
  memberships     Membership[]
  refreshSessions RefreshSession[]
  auditLogs       AuditLog[]
  employee        Employee?

  @@index([email])
  @@index([status])
  @@map("users")
}

model Membership {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  roleId         String
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([roleId])
  @@map("memberships")
}

model Role {
  id             String           @id @default(uuid())
  organizationId String?          // Nullable for system-wide predefined default roles
  name           String
  slug           String
  description    String?
  isSystemRole   Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  permissions    RolePermission[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([slug])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique // e.g., "org:read", "employee:create"
  name        String
  module      String           // e.g., "ORGANIZATION", "EMPLOYEE", "ATTENDANCE"
  description String?
  createdAt   DateTime         @default(now())

  roles       RolePermission[]

  @@index([code])
  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshSession {
  id                 String       @id @default(uuid())
  userId             String
  organizationId     String?
  tokenFamily        String       // Used for reuse detection
  hashedRefreshToken String
  isRevoked          Boolean      @default(false)
  expiresAt          DateTime
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenFamily])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String?      // Nullable for platform/SuperAdmin operations
  userId         String?      // Nullable for unauthenticated security events
  action         AuditAction
  entityType     String       // e.g., "User", "Organization", "Employee"
  entityId       String?
  description    String?
  oldValues      Json?
  newValues      Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}

// -------------------------------------------------------------
// MODULE EXPANSION PRE-WIRED MODELS
// -------------------------------------------------------------

model Department {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  code           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees      Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("departments")
}

model Designation {
  id             String       @id @default(uuid())
  organizationId String
  title          String
  code           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees      Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("designations")
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  code           String
  address        String?
  city           String?
  state          String?
  country        String       @default("India")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees      Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("branches")
}

model Employee {
  id             String          @id @default(uuid())
  organizationId String
  userId         String?         @unique
  employeeCode   String
  firstName      String
  lastName       String
  workEmail      String
  personalEmail  String?
  phone          String?
  dateOfBirth    DateTime?
  gender         String?
  joiningDate    DateTime
  status         EmployeeStatus  @default(ACTIVE)
  employmentType EmploymentType  @default(FULL_TIME)
  
  departmentId   String?
  designationId  String?
  branchId       String?
  managerId      String?
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation    Designation?    @relation(fields: [designationId], references: [id], onDelete: SetNull)
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  manager        Employee?       @relation("ManagerReports", fields: [managerId], references: [id], onDelete: SetNull)
  directReports  Employee[]      @relation("ManagerReports")

  attendances        Attendance[]
  attendanceRegularizations AttendanceRegularization[]
  leaveRequests      LeaveRequest[]
  payrollItems       PayrollItem[]
  employeeDocuments  EmployeeDocument[]
  emergencyContacts  EmergencyContact[]
  onboardingTasks    OnboardingTask[]
  lifecycleEvents    LifecycleEvent[]

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, workEmail])
  @@index([organizationId])
  @@index([departmentId])
  @@index([designationId])
  @@index([status])
  @@map("employees")
}

model EmployeeDocument {
  id             String       @id @default(uuid())
  organizationId String
  employeeId     String
  documentType   DocumentType
  title          String
  fileUrl        String
  fileName       String
  fileSize       Int?
  mimeType       String?
  expiryDate     DateTime?    @db.Date
  isVerified     Boolean      @default(false)
  verifiedAt     DateTime?
  verifiedBy     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([employeeId])
  @@index([documentType])
  @@map("employee_documents")
}

model EmergencyContact {
  id           String   @id @default(uuid())
  employeeId   String
  name         String
  relationship String
  phone        String
  email        String?
  address      String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("emergency_contacts")
}

model OnboardingTask {
  id             String                 @id @default(uuid())
  organizationId String
  employeeId     String
  title          String
  description    String?
  category       OnboardingTaskCategory @default(DOCUMENT_SUBMISSION)
  status         OnboardingTaskStatus   @default(PENDING)
  dueDate        DateTime?              @db.Date
  completedAt    DateTime?
  completedBy    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([employeeId])
  @@index([status])
  @@map("onboarding_tasks")
}

model LifecycleEvent {
  id             String             @id @default(uuid())
  organizationId String
  employeeId     String
  eventType      LifecycleEventType
  description    String
  effectiveDate  DateTime           @default(now()) @db.Date
  createdBy      String?
  metadata       Json?
  createdAt      DateTime           @default(now())

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([employeeId])
  @@index([eventType])
  @@map("lifecycle_events")
}

model Shift {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  startTime      String       // Format "HH:mm"
  endTime        String       // Format "HH:mm"
  graceMinutes   Int          @default(15)
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attendances    Attendance[]

  @@index([organizationId])
  @@map("shifts")
}

model Attendance {
  id                 String           @id @default(uuid())
  organizationId     String
  employeeId         String
  shiftId            String?
  date               DateTime         @db.Date
  checkIn            DateTime?
  checkOut           DateTime?
  totalMinutes       Int              @default(0)
  productiveMinutes  Int              @default(0)
  overtimeMinutes    Int              @default(0)
  status             AttendanceStatus @default(PRESENT)
  isLate             Boolean          @default(false)
  isEarlyLeave       Boolean          @default(false)
  isRegularized      Boolean          @default(false)
  ipAddress          String?
  location           String?
  remarks            String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee           Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift              Shift?           @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  breaks             AttendanceBreak[]
  regularizations    AttendanceRegularization[]

  @@unique([employeeId, date])
  @@index([organizationId])
  @@index([employeeId])
  @@index([date])
  @@map("attendances")
}

model AttendanceBreak {
  id                 String          @id @default(uuid())
  attendanceId       String
  breakType          BreakType       @default(LUNCH)
  startTime          DateTime        @default(now())
  endTime            DateTime?
  durationMinutes    Int             @default(0)
  remarks            String?
  createdAt          DateTime        @default(now())

  attendance         Attendance      @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
  @@map("attendance_breaks")
}

model AttendanceRegularization {
  id                 String               @id @default(uuid())
  organizationId     String
  employeeId         String
  attendanceId       String?
  date               DateTime             @db.Date
  requestedCheckIn   DateTime?
  requestedCheckOut  DateTime?
  reason             String
  status             RegularizationStatus @default(PENDING)
  approvedById       String?
  managerRemarks     String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee           Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendance         Attendance?          @relation(fields: [attendanceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([employeeId])
  @@map("attendance_regularizations")
}

model LeaveType {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  code           String
  daysAllowed    Int            @default(12)
  isCarryForward Boolean        @default(false)
  isPaid         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaveRequests  LeaveRequest[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("leave_types")
}

model LeaveRequest {
  id             String       @id @default(uuid())
  organizationId String
  employeeId     String
  leaveTypeId    String
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  totalDays      Float
  reason         String
  status         LeaveStatus  @default(PENDING)
  actionReason   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([employeeId])
  @@index([status])
  @@map("leave_requests")
}

model PayrollRun {
  id             String        @id @default(uuid())
  organizationId String
  month          Int
  year           Int
  status         PayrollStatus @default(DRAFT)
  totalGross     Decimal       @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal      @default(0) @db.Decimal(12, 2)
  totalNet       Decimal       @default(0) @db.Decimal(12, 2)
  processedAt    DateTime?
  approvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollItems   PayrollItem[]

  @@unique([organizationId, month, year])
  @@index([organizationId])
  @@map("payroll_runs")
}

model PayrollItem {
  id             String      @id @default(uuid())
  payrollRunId   String
  employeeId     String
  basicSalary    Decimal     @db.Decimal(10, 2)
  hra            Decimal     @default(0) @db.Decimal(10, 2)
  allowances     Decimal     @default(0) @db.Decimal(10, 2)
  pfDeduction    Decimal     @default(0) @db.Decimal(10, 2)
  taxDeduction   Decimal     @default(0) @db.Decimal(10, 2)
  otherDeductions Decimal    @default(0) @db.Decimal(10, 2)
  netSalary      Decimal     @db.Decimal(10, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  payrollRun     PayrollRun  @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee       Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([payrollRunId, employeeId])
  @@index([payrollRunId])
  @@index([employeeId])
  @@map("payroll_items")
}
