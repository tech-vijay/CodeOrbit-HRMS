datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum OrganizationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  PENDING_VERIFICATION
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REVOKED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_RESET
  TOKEN_REFRESH
  TOKEN_REUSE_DETECTED
  ORGANIZATION_SWITCH
  PERMISSION_GRANT
  PERMISSION_REVOKE
  EXPORT
}

enum EmployeeStatus {
  PROBATION
  ACTIVE
  INACTIVE
  NOTICE_PERIOD
  TERMINATED
  RESIGNED
  ON_LEAVE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  REMOTE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  ON_LEAVE
  HOLIDAY
  WEEK_OFF
}

enum BreakType {
  LUNCH
  TEA
  PERSONAL
  MEETING
}

enum RegularizationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum HalfDaySession {
  FIRST_HALF
  SECOND_HALF
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  APPROVED
  PAID
  CANCELLED
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum WorkplaceType {
  ON_SITE
  HYBRID
  REMOTE
}

enum CandidateStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER_EXTENDED
  HIRED
  REJECTED
}

enum DocumentType {
  IDENTITY_PROOF
  EMPLOYMENT_CONTRACT
  OFFER_LETTER
  RESUME
  EDUCATIONAL_CERTIFICATE
  EXPERIENCE_LETTER
  PAYSLIP_PREVIOUS
  OTHER
}

enum OnboardingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  WAIVED
}

enum OnboardingTaskCategory {
  DOCUMENT_SUBMISSION
  IT_PROVISIONING
  HR_ORIENTATION
  POLICY_ACKNOWLEDGEMENT
  TRAINING
}

enum LifecycleEventType {
  HIRED
  STATUS_CHANGE
  PROBATION_COMPLETED
  PROMOTED
  DESIGNATION_CHANGE
  DEPARTMENT_TRANSFER
  SALARY_REVISION
  RESIGNED
  TERMINATED
}

enum PerformanceCycleStatus {
  DRAFT
  ACTIVE
  EVALUATION
  CALIBRATION
  COMPLETED
  ARCHIVED
}

enum ReviewType {
  QUARTERLY
  ANNUAL
  MID_YEAR
  PROBATION
}

enum GoalCategory {
  INDIVIDUAL
  DEPARTMENT
  COMPANY
  DEVELOPMENT
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  BLOCKED
}

enum ReviewStatus {
  PENDING_SELF
  PENDING_MANAGER
  PENDING_HR
  COMPLETED
}

enum ExpenseCategory {
  TRAVEL
  MEALS
  EQUIPMENT
  INTERNET
  TRAINING
  CLIENT_ENTERTAINMENT
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED_BY_MANAGER
  APPROVED_BY_FINANCE
  REJECTED
  REIMBURSED
}

enum NotificationType {
  LEAVE
  EXPENSE
  PERFORMANCE
  ATTENDANCE
  PAYROLL
  SYSTEM
}

// -------------------------------------------------------------
// CORE MULTI-TENANCY & RBAC MODELS
// -------------------------------------------------------------

model Organization {
  id           String             @id @default(uuid())
  name         String
  slug         String             @unique
  legalName    String?
  logoUrl      String?
  website      String?
  email        String
  phone        String?
  taxId        String?
  status       OrganizationStatus @default(ACTIVE)
  
  // Regional & operational settings
  timezone     String             @default("Asia/Kolkata")
  currency     String             @default("INR")
  address      String?
  city         String?
  state        String?
  country      String             @default("India")
  postalCode   String?
  
  // Organization Employee & Working Policy Settings
  employeeCodePrefix   String       @default("EMP")
  employeeCodeCounter  Int          @default(1)
  workingDays          String[]     @default(["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY"])
  
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  // Relationships
  memberships        Membership[]
  roles              Role[]
  departments        Department[]
  designations       Designation[]
  branches           Branch[]
  employees          Employee[]
  employeeDocuments  EmployeeDocument[]
  onboardingTasks    OnboardingTask[]
  lifecycleEvents    LifecycleEvent[]
  auditLogs          AuditLog[]
  refreshSessions    RefreshSession[]
  shifts             Shift[]
  attendances        Attendance[]
  attendanceRegularizations AttendanceRegularization[]
  leaveTypes         LeaveType[]
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  companyHolidays    CompanyHoliday[]
  salaryStructures   SalaryStructure[]
  payrollRuns        PayrollRun[]
  jobPostings               JobPosting[]
  candidates                Candidate[]
  performanceCycles         PerformanceCycle[]
  goals                     Goal[]
  performanceReviews        PerformanceReview[]
  expenseClaims             ExpenseClaim[]
  notifications             Notification[]
  memberInvitations         MemberInvitation[]

  @@index([slug])
  @@index([status])
  @@map("organizations")
}

model User {
  id                  String       @id @default(uuid())
  email               String       @unique
  passwordHash        String
  firstName           String
  lastName            String
  phone               String?
  avatarUrl           String?
  isSuperAdmin        Boolean      @default(false)
  isEmailVerified     Boolean      @default(false)
  status              UserStatus   @default(ACTIVE)
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // Relationships
  memberships     Membership[]
  refreshSessions RefreshSession[]
  auditLogs       AuditLog[]
  employees       Employee[]
  approvedLeaves    LeaveRequest[]   @relation("LeaveApprover")
  approvedPayrolls  PayrollRun[]     @relation("PayrollApprover")
  notifications     Notification[]
  memberInvitations MemberInvitation[]

  @@index([email])
  @@index([status])
  @@map("users")
}

model Membership {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  roleId         String
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitation   MemberInvitation?

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([roleId])
  @@map("memberships")
}

model Role {
  id             String           @id @default(uuid())
  organizationId String?          // Nullable for system-wide predefined default roles
  name           String
  slug           String
  description    String?
  isSystemRole   Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  permissions    RolePermission[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([slug])
  @@map("roles")
}

model MemberInvitation {
  id             String    @id @default(uuid())
  organizationId String
  membershipId   String    @unique
  userId         String
  tokenHash      String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([expiresAt])
  @@map("member_invitations")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique // e.g., "org:read", "employee:create"
  name        String
  module      String           // e.g., "ORGANIZATION", "EMPLOYEE", "ATTENDANCE"
  description String?
  createdAt   DateTime         @default(now())

  roles       RolePermission[]

  @@index([code])
  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshSession {
  id                 String       @id @default(uuid())
  userId             String
  organizationId     String?
  tokenFamily        String       // Used for reuse detection
  hashedRefreshToken String
  isRevoked          Boolean      @default(false)
  expiresAt          DateTime
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenFamily])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String?      // Nullable for platform/SuperAdmin operations
  userId         String?      // Nullable for unauthenticated security events
  action         AuditAction
  entityType     String       // e.g., "User", "Organization", "Employee"
  entityId       String?
  description    String?
  oldValues      Json?
  newValues      Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}

// -------------------------------------------------------------
// MODULE EXPANSION PRE-WIRED MODELS
// -------------------------------------------------------------

model Department {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  code           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees      Employee[]
  jobPostings  JobPosting[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("departments")
}

model Designation {
  id             String       @id @default(uuid())
  organizationId String
  title          String
  code           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees      Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("designations")
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  code           String
  address        String?
  city           String?
  state          String?
  country        String       @default("India")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees      Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("branches")
}

model Employee {
  id             String          @id @default(uuid())
  organizationId String
  userId         String?
  employeeCode   String
  firstName      String
  lastName       String
  workEmail      String
  personalEmail  String?
  phone          String?
  panNumber      String?
  uan            String?
  bankAccountHolderName String?
  bankAccountNumber String?
  bankIfsc       String?
  dateOfBirth    DateTime?
  gender         String?
  joiningDate    DateTime
  status         EmployeeStatus  @default(ACTIVE)
  employmentType EmploymentType  @default(FULL_TIME)
  
  departmentId   String?
  designationId  String?
  branchId       String?
  managerId      String?
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation    Designation?    @relation(fields: [designationId], references: [id], onDelete: SetNull)
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  manager        Employee?       @relation("ManagerReports", fields: [managerId], references: [id], onDelete: SetNull)
  directReports  Employee[]      @relation("ManagerReports")

  attendances        Attendance[]
  attendanceRegularizations AttendanceRegularization[]
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  salaryStructures   SalaryStructure[]
  payrollItems       PayrollItem[]
  employeeDocuments  EmployeeDocument[]
  emergencyContacts  EmergencyContact[]
  onboardingTasks    OnboardingTask[]
  lifecycleEvents    LifecycleEvent[]
  goals                     Goal[]
  reviewsAsEmployee         PerformanceReview[]        @relation("EmployeeReviews")
  reviewsAsReviewer         PerformanceReview[]        @relation("ReviewerEvaluations")
  expenseClaims             ExpenseClaim[]             @relation("EmployeeExpenseClaims")
  approvedExpenses          ExpenseClaim[]             @relation("ApproverExpenseClaims")

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, workEmail])
  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([departmentId])
  @@index([designationId])
  @@index([status])
  @@map("employees")
}

model EmployeeDocument {
  id             String       @id @default(uuid())
  organizationId String
  employeeId     String
  documentType   DocumentType
  title          String
  fileUrl        String
  fileName       String
  fileSize       Int?
  mimeType       String?
  expiryDate     DateTime?    @db.Date
  isVerified     Boolean      @default(false)
  verifiedAt     DateTime?
  verifiedBy     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([employeeId])
  @@index([documentType])
  @@map("employee_documents")
}

model EmergencyContact {
  id           String   @id @default(uuid())
  employeeId   String
  name         String
  relationship String
  phone        String
  email        String?
  address      String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("emergency_contacts")
}

model OnboardingTask {
  id             String                 @id @default(uuid())
  organizationId String
  employeeId     String
  title          String
  description    String?
  category       OnboardingTaskCategory @default(DOCUMENT_SUBMISSION)
  status         OnboardingTaskStatus   @default(PENDING)
  dueDate        DateTime?              @db.Date
  completedAt    DateTime?
  completedBy    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([employeeId])
  @@index([status])
  @@map("onboarding_tasks")
}

model LifecycleEvent {
  id             String             @id @default(uuid())
  organizationId String
  employeeId     String
  eventType      LifecycleEventType
  description    String
  effectiveDate  DateTime           @default(now()) @db.Date
  createdBy      String?
  metadata       Json?
  createdAt      DateTime           @default(now())

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([employeeId])
  @@index([eventType])
  @@map("lifecycle_events")
}

model Shift {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  startTime      String       // Format "HH:mm"
  endTime        String       // Format "HH:mm"
  graceMinutes   Int          @default(15)
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attendances    Attendance[]

  @@index([organizationId])
  @@map("shifts")
}

model Attendance {
  id                 String           @id @default(uuid())
  organizationId     String
  employeeId         String
  shiftId            String?
  date               DateTime         @db.Date
  checkIn            DateTime?
  checkOut           DateTime?
  totalMinutes       Int              @default(0)
  productiveMinutes  Int              @default(0)
  overtimeMinutes    Int              @default(0)
  status             AttendanceStatus @default(PRESENT)
  isLate             Boolean          @default(false)
  isEarlyLeave       Boolean          @default(false)
  isRegularized      Boolean          @default(false)
  ipAddress          String?
  location           String?
  remarks            String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee           Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift              Shift?           @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  breaks             AttendanceBreak[]
  regularizations    AttendanceRegularization[]

  @@unique([employeeId, date])
  @@index([organizationId])
  @@index([employeeId])
  @@index([date])
  @@map("attendances")
}

model AttendanceBreak {
  id                 String          @id @default(uuid())
  attendanceId       String
  breakType          BreakType       @default(LUNCH)
  startTime          DateTime        @default(now())
  endTime            DateTime?
  durationMinutes    Int             @default(0)
  remarks            String?
  createdAt          DateTime        @default(now())

  attendance         Attendance      @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
  @@map("attendance_breaks")
}

model AttendanceRegularization {
  id                 String               @id @default(uuid())
  organizationId     String
  employeeId         String
  attendanceId       String?
  date               DateTime             @db.Date
  requestedCheckIn   DateTime?
  requestedCheckOut  DateTime?
  reason             String
  status             RegularizationStatus @default(PENDING)
  approvedById       String?
  managerRemarks     String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee           Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendance         Attendance?          @relation(fields: [attendanceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([employeeId])
  @@map("attendance_regularizations")
}

model LeaveType {
  id                  String         @id @default(uuid())
  organizationId      String
  name                String
  code                String
  description         String?
  daysAllowed         Float          @default(12)
  isCarryForward      Boolean        @default(false)
  carryForwardMaxDays Float          @default(0)
  isPaid              Boolean        @default(true)
  requiresAttachment  Boolean        @default(false)
  color               String         @default("#E52328")
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("leave_types")
}

model LeaveBalance {
  id               String       @id @default(uuid())
  organizationId   String
  employeeId       String
  leaveTypeId      String
  year             Int
  allocatedDays    Float        @default(0)
  usedDays         Float        @default(0)
  pendingDays      Float        @default(0)
  carryForwardDays Float        @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee         Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType        LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@index([organizationId])
  @@index([employeeId])
  @@map("leave_balances")
}

model LeaveRequest {
  id                 String          @id @default(uuid())
  organizationId     String
  employeeId         String
  leaveTypeId        String
  startDate          DateTime        @db.Date
  endDate            DateTime        @db.Date
  totalDays          Float
  isHalfDay          Boolean         @default(false)
  halfDaySession     HalfDaySession?
  reason             String
  attachmentUrl      String?
  status             LeaveStatus     @default(PENDING)
  appliedAt          DateTime        @default(now())
  approvedById       String?
  approvedAt         DateTime?
  managerRemarks     String?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee           Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType          LeaveType       @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  approvedBy         User?           @relation("LeaveApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([employeeId])
  @@index([status])
  @@map("leave_requests")
}

model CompanyHoliday {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  date           DateTime     @db.Date
  description    String?
  isMandatory    Boolean      @default(true)
  year           Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@index([organizationId])
  @@map("company_holidays")
}

// -------------------------------------------------------------
// PHASE 5: PAYROLL & COMPENSATION ENGINE
// -------------------------------------------------------------

model SalaryStructure {
  id              String       @id @default(uuid())
  organizationId  String
  employeeId      String
  ctc             Decimal      @db.Decimal(12, 2)
  basicSalary     Decimal      @db.Decimal(10, 2)
  hra             Decimal      @default(0) @db.Decimal(10, 2)
  specialAllowance Decimal     @default(0) @db.Decimal(10, 2)
  conveyance      Decimal      @default(0) @db.Decimal(10, 2)
  medicalAllowance Decimal     @default(0) @db.Decimal(10, 2)
  pfEmployer      Decimal      @default(0) @db.Decimal(10, 2)
  pfEmployee      Decimal      @default(0) @db.Decimal(10, 2)
  professionalTax Decimal      @default(0) @db.Decimal(10, 2)
  tds             Decimal      @default(0) @db.Decimal(10, 2)
  effectiveFrom   DateTime
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee        Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([employeeId])
  @@map("salary_structures")
}

model PayrollRun {
  id              String        @id @default(uuid())
  organizationId  String
  month           Int
  year            Int
  status          PayrollStatus @default(DRAFT)
  totalGross      Decimal       @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal       @default(0) @db.Decimal(12, 2)
  totalNet        Decimal       @default(0) @db.Decimal(12, 2)
  employeeCount   Int           @default(0)
  approvedById    String?
  approvedAt      DateTime?
  processedAt     DateTime?
  disbursedAt     DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvedBy      User?         @relation("PayrollApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  payrollItems    PayrollItem[]

  @@unique([organizationId, month, year])
  @@index([organizationId])
  @@index([status])
  @@map("payroll_runs")
}

model PayrollItem {
  id               String      @id @default(uuid())
  payrollRunId     String
  employeeId       String
  monthDays        Int         @default(30)
  payableDays      Decimal     @default(30) @db.Decimal(5, 2)
  lopDays          Decimal     @default(0) @db.Decimal(5, 2)
  
  // Earnings
  basicSalary      Decimal     @db.Decimal(10, 2)
  hra              Decimal     @default(0) @db.Decimal(10, 2)
  specialAllowance Decimal     @default(0) @db.Decimal(10, 2)
  conveyance       Decimal     @default(0) @db.Decimal(10, 2)
  medicalAllowance Decimal     @default(0) @db.Decimal(10, 2)
  reimbursements   Decimal @default(0) @db.Decimal(10, 2)
  grossSalary      Decimal     @db.Decimal(10, 2)

  // Deductions
  pfDeduction      Decimal     @default(0) @db.Decimal(10, 2)
  professionalTax  Decimal     @default(0) @db.Decimal(10, 2)
  tdsDeduction     Decimal     @default(0) @db.Decimal(10, 2)
  lopDeduction     Decimal     @default(0) @db.Decimal(10, 2)
  totalDeductions  Decimal     @db.Decimal(10, 2)

  // Net Pay
  netSalary        Decimal     @db.Decimal(10, 2)
  
  // Status & Payment Reference
  isPaid           Boolean     @default(false)
  paymentMode      String?     @default("BANK_TRANSFER")
  paymentRef       String?
  paidAt           DateTime?

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  payrollRun       PayrollRun  @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee         Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  expenseClaims ExpenseClaim[]

  @@unique([payrollRunId, employeeId])
  @@index([payrollRunId])
  @@index([employeeId])
  @@map("payroll_items")
}

// -------------------------------------------------------------
// PHASE 6: RECRUITMENT & APPLICANT TRACKING SYSTEM (ATS)
// -------------------------------------------------------------

model JobPosting {
  id               String         @id @default(uuid())
  organizationId   String
  departmentId     String?
  title            String
  slug             String
  description      String         @db.Text
  requirements     String?        @db.Text
  responsibilities String?        @db.Text
  location         String         @default("Bengaluru, India")
  workplaceType    WorkplaceType  @default(HYBRID)
  employmentType   EmploymentType @default(FULL_TIME)
  experienceYears  String?        @default("2-5 years")
  minSalary        Decimal?       @db.Decimal(12, 2)
  maxSalary        Decimal?       @db.Decimal(12, 2)
  openings         Int            @default(1)
  status           JobStatus      @default(PUBLISHED)
  viewsCount       Int            @default(0)
  closedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  candidates   Candidate[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([status])
  @@index([departmentId])
  @@map("job_postings")
}

model Candidate {
  id               String         @id @default(uuid())
  organizationId   String
  jobPostingId     String
  fullName         String
  email            String
  phone            String?
  resumeUrl        String?
  portfolioUrl     String?
  linkedinUrl      String?
  currentCompany   String?
  currentCtc       Decimal?       @db.Decimal(12, 2)
  expectedCtc      Decimal?       @db.Decimal(12, 2)
  noticePeriodDays Int?           @default(30)
  stage            CandidateStage @default(APPLIED)
  rating           Int?           @default(0) // 1-5 stars
  rejectionReason  String?
  hiredAt          DateTime?
  appliedAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobPosting   JobPosting       @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  interviews   InterviewRound[]
  notes        CandidateNote[]

  @@unique([jobPostingId, email])
  @@index([organizationId])
  @@index([jobPostingId])
  @@index([stage])
  @@map("candidates")
}

model InterviewRound {
  id              String   @id @default(uuid())
  candidateId     String
  roundName       String // e.g. Technical Screening, System Design, HR Cultural Fit
  roundNumber     Int      @default(1)
  scheduledAt     DateTime
  interviewerName String?
  meetingLink     String?
  feedback        String?  @db.Text
  rating          Int? // 1-5 score
  isCompleted     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("interview_rounds")
}

model CandidateNote {
  id          String   @id @default(uuid())
  candidateId String
  authorName  String   @default("HR Recruiter")
  content     String   @db.Text
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_notes")
}

// -------------------------------------------------------------
// PERFORMANCE MANAGEMENT & OKRS (PMS)
// -------------------------------------------------------------

model PerformanceCycle {
  id                    String                 @id @default(uuid())
  organizationId        String
  title                 String
  description           String?
  reviewType            ReviewType             @default(QUARTERLY)
  status                PerformanceCycleStatus @default(ACTIVE)
  startDate             DateTime
  endDate               DateTime
  selfReviewDeadline    DateTime?
  managerReviewDeadline DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goals        Goal[]
  reviews      PerformanceReview[]

  @@index([organizationId, status])
  @@map("performance_cycles")
}

model Goal {
  id             String       @id @default(uuid())
  organizationId String
  employeeId     String
  cycleId        String?
  title          String
  description    String?      @db.Text
  category       GoalCategory @default(INDIVIDUAL)
  weightage      Int          @default(100) // Percentage weight
  progress       Int          @default(0) // 0 - 100%
  targetValue    Float?
  currentValue   Float?
  unit           String?      @default("%")
  status         GoalStatus   @default(IN_PROGRESS)
  dueDate        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycle        PerformanceCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  keyResults   KeyResult[]

  @@index([organizationId, employeeId])
  @@index([cycleId])
  @@map("goals")
}

model KeyResult {
  id           String   @id @default(uuid())
  goalId       String
  title        String
  targetValue  Float    @default(100)
  currentValue Float    @default(0)
  unit         String?  @default("%")
  isCompleted  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("key_results")
}

model PerformanceReview {
  id                   String       @id @default(uuid())
  organizationId       String
  cycleId              String
  employeeId           String
  reviewerId           String?
  status               ReviewStatus @default(PENDING_SELF)
  selfRating           Float? // 1.0 - 5.0
  selfFeedback         String?      @db.Text
  managerRating        Float? // 1.0 - 5.0
  managerFeedback      String?      @db.Text
  finalRating          Float? // Calibrated final rating (1.0 - 5.0)
  promotionRecommended Boolean      @default(false)
  salaryHikePercentage Float?
  pipRequired          Boolean      @default(false)
  pipNotes             String?      @db.Text
  submittedAt          DateTime?
  completedAt          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cycle        PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee     Employee         @relation("EmployeeReviews", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer     Employee?        @relation("ReviewerEvaluations", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@unique([cycleId, employeeId])
  @@index([organizationId, cycleId])
  @@index([employeeId])
  @@index([reviewerId])
  @@map("performance_reviews")
}

// -------------------------------------------------------------
// EXPENSE CLAIMS & REIMBURSEMENTS
// -------------------------------------------------------------

model ExpenseClaim {
  id              String          @id @default(uuid())
  organizationId  String
  employeeId      String
  approverId      String?
  payrollItemId   String?
  title           String
  description     String?         @db.Text
  category        ExpenseCategory @default(TRAVEL)
  amount          Decimal         @db.Decimal(10, 2)
  currency        String          @default("INR")
  expenseDate     DateTime
  receiptUrl      String?
  receiptName     String?
  status          ExpenseStatus   @default(PENDING)
  rejectionReason String?         @db.Text
  approvedAt      DateTime?
  reimbursedAt    DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation("EmployeeExpenseClaims", fields: [employeeId], references: [id], onDelete: Cascade)
  approver     Employee?    @relation("ApproverExpenseClaims", fields: [approverId], references: [id], onDelete: SetNull)
  payrollItem  PayrollItem? @relation(fields: [payrollItemId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([employeeId])
  @@index([payrollItemId])
  @@map("expense_claims")
}

// -------------------------------------------------------------
// IN-APP NOTIFICATIONS
// -------------------------------------------------------------

model Notification {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  title          String
  message        String           @db.Text
  type           NotificationType @default(SYSTEM)
  link           String?
  isRead         Boolean          @default(false)
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, isRead])
  @@index([userId, isRead])
  @@map("notifications")
}
